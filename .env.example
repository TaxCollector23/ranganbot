# Copy this file to .env and fill in real values. Never commit .env.

# Secret bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Your personal Discord user ID (numeric snowflake). Enable Developer Mode in
# Discord (User Settings -> Advanced), then right-click your name -> Copy User ID.
DISCORD_ALLOWED_USER_ID=123456789012345678

# The Discord server (guild) ID of your private server. Right-click the
# server icon -> Copy Server ID (Developer Mode must be enabled).
DISCORD_ALLOWED_GUILD_ID=123456789012345678
